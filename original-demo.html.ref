<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Prospecting Call Tracker — Working Demo</title>
<meta name="color-scheme" content="light dark">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" crossorigin="anonymous"></script>
<style>
  :root { color-scheme: light dark; --brand:#2F6FEB; --brand-tint:#EAF1FE; --success:#22A55B; --warning:#E8930C; --danger:#E0443E; --bg:#F5F7FB; --surface:#FFFFFF; --surface-subtle:#F3F5F9; --ink:#111827; --ink-muted:#374151; --ink-subtle:#6B7280; --border:#E5E9F0; --border-strong:#D5DBE5; --radius:16px; --green-text:#1a7f45; --orange-text:#a35f00; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg:#0F1319; --surface:#171C24; --surface-subtle:#1F2630; --ink:#F3F4F6; --ink-muted:#D1D5DB; --ink-subtle:#9CA3AF; --border:#2A323E; --border-strong:#3A4452; --brand:#5B8DEF; --brand-tint:rgba(91,141,239,.16); --success:#34C776; --warning:#F0A030; --danger:#F06060; --green-text:#34C776; --orange-text:#F0A030; } }
  :root[data-theme="dark"] { --bg:#0F1319; --surface:#171C24; --surface-subtle:#1F2630; --ink:#F3F4F6; --ink-muted:#D1D5DB; --ink-subtle:#9CA3AF; --border:#2A323E; --border-strong:#3A4452; --brand:#5B8DEF; --brand-tint:rgba(91,141,239,.16); --success:#34C776; --warning:#F0A030; --danger:#F06060; --green-text:#34C776; --orange-text:#F0A030; }
  * { box-sizing:border-box; } html,body { margin:0; }
  body { font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink); font-size:15px; line-height:1.5; }
  a { color:var(--brand); text-decoration:none; } button { font:inherit; cursor:pointer; }
  .banner { background:var(--brand-tint); color:var(--brand); font-size:12px; padding:6px 16px; text-align:center; font-weight:600; border-bottom:1px solid var(--border); }
  .layout { display:grid; grid-template-columns:280px 1fr; min-height:calc(100vh - 32px); } .layout.collapsed { grid-template-columns:76px 1fr; }
  .layout > * { min-width:0; }
  .sidebar { background:var(--surface); border-right:1px solid var(--border); padding:14px 10px; position:sticky; top:0; height:calc(100vh - 32px); overflow:auto; display:flex; flex-direction:column; }
  .logo { display:flex; align-items:center; gap:12px; padding:8px 10px 20px; line-height:1.15; }
  .logo .mark { width:40px; height:40px; border-radius:12px; background:var(--brand); color:#fff; display:grid; place-items:center; font-size:19px; flex-shrink:0; }
  .logo b { display:block; font-size:16px; font-weight:700; } .logo small { display:block; font-size:12px; color:var(--ink-subtle); font-weight:500; }
  .nav { display:flex; flex-direction:column; gap:4px; }
  .nav a { display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:12px; color:var(--ink-muted); font-weight:500; font-size:15px; border:2px solid transparent; }
  .nav a .ic { width:22px; text-align:center; color:var(--ink-subtle); font-size:17px; } .nav a:hover { background:var(--surface-subtle); }
  .nav a.active { background:var(--brand-tint); color:var(--brand); border-color:var(--brand); font-weight:600; } .nav a.active .ic { color:var(--brand); }
  .nav .group { display:none; }
  .collapse { margin-top:auto; padding:12px 14px; color:var(--ink-muted); font-weight:500; display:flex; gap:12px; align-items:center; border-top:1px solid var(--border); cursor:pointer; }
  .layout.collapsed .logo b, .layout.collapsed .logo small, .layout.collapsed .nav a span.t, .layout.collapsed .collapse span.t { display:none; }
  .layout.collapsed .nav a, .layout.collapsed .collapse { justify-content:center; padding-left:0; padding-right:0; }
  .topbar { position:sticky; top:0; z-index:5; background:var(--surface); border-bottom:1px solid var(--border); min-height:64px; display:flex; align-items:center; gap:10px; padding:0 28px; }
  .topbar h1 { font-size:22px; margin:0; flex:1; min-width:0; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; letter-spacing:-.01em; }
  .pill { border:0; background:transparent; border-radius:10px; padding:6px 4px; font-size:15px; color:var(--ink); } .pill.team { font-weight:600; } .pill.who { color:var(--ink-subtle); cursor:pointer; }
  .pill.who::after { content:""; display:inline-block; width:26px; height:26px; border:2px solid var(--ink-subtle); border-radius:50%; margin-left:10px; vertical-align:middle; }
  .avatar { width:32px; height:32px; border-radius:50%; background:var(--brand-tint); color:var(--brand); display:grid; place-items:center; font-weight:700; font-size:12px; flex-shrink:0; }
  main { padding:32px 40px 40px; max-width:1360px; margin:0 auto; }
  .page-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:22px; flex-wrap:wrap; }
  .page-head h2 { font-size:28px; margin:0; letter-spacing:-.02em; font-weight:700; } .page-head p { margin:6px 0 0; color:var(--ink-subtle); font-size:16px; }
  .actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px 24px; box-shadow:0 1px 2px rgba(16,24,40,.03); }
  .card h4 { margin:0 0 10px; font-size:17px; font-weight:700; }
  .grid { display:grid; gap:16px; } .g4 { grid-template-columns:repeat(4,1fr);} .g3 { grid-template-columns:repeat(3,1fr);} .g2 { grid-template-columns:repeat(2,1fr);}
  @media (max-width:1100px){ .g4{grid-template-columns:repeat(2,1fr);} .g3{grid-template-columns:1fr 1fr;} }
  @media (max-width:700px){ .g4,.g3,.g2{grid-template-columns:1fr;} }
  .kpi { display:grid; grid-template-columns:52px 1fr; column-gap:16px; align-items:start; }
  .kpi::before { content:"●"; grid-row:1 / span 3; width:52px; height:52px; border-radius:12px; background:var(--brand-tint); color:var(--brand); display:grid; place-items:center; font-size:14px; }
  .kpi .label { color:var(--ink-muted); font-size:15px; font-weight:500; } .kpi .value { font-size:32px; font-weight:700; letter-spacing:-.02em; margin-top:2px; line-height:1.1; } .kpi .sub { font-size:14px; color:var(--ink-subtle); margin-top:4px; }
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; border:0; border-radius:12px; padding:10px 18px; font-weight:600; font-size:15px; background:var(--brand); color:#fff; white-space:nowrap; transition:transform .08s, filter .1s; }
  .btn:hover { filter:brightness(.96); } .btn:active { transform:scale(.97); } .btn.tint { background:var(--brand-tint); color:var(--brand); } .btn.plain { background:transparent; color:var(--brand); }
  .btn.success { background:var(--success); color:#fff; } .btn.danger { background:var(--danger); color:#fff; } .btn.danger.tint { background:rgba(255,59,48,.12); color:var(--danger); }
  .btn.gray { background:var(--surface-subtle); color:var(--ink); }
  .btn.lg { padding:14px 22px; font-size:17px; border-radius:14px; } .btn.sm { padding:6px 12px; font-size:13px; border-radius:9px; }
  .btn[disabled], a.btn.off { opacity:.45; cursor:not-allowed; }
  .badge { display:inline-block; font-size:12px; font-weight:600; padding:3px 9px; border-radius:999px; background:var(--surface-subtle); color:var(--ink-muted); white-space:nowrap; }
  .badge.blue { background:var(--brand-tint); color:var(--brand); } .badge.green { background:rgba(52,199,89,.15); color:var(--green-text); } .badge.orange { background:rgba(255,149,0,.16); color:var(--orange-text); } .badge.red { background:rgba(255,59,48,.14); color:var(--danger); }
  input,select,textarea { font:inherit; color:var(--ink); background:var(--surface); border:1px solid var(--border-strong); border-radius:12px; padding:11px 14px; width:100%; }
  input[type=checkbox] { width:auto; } input:focus,select:focus,textarea:focus { outline:none; border-color:var(--brand); box-shadow:0 0 0 3px var(--brand-tint); }
  input:disabled,select:disabled,textarea:disabled { background:var(--surface-subtle); color:var(--ink-subtle); }
  .fld { min-width:0; }
  .fld + .fld { margin-top:0; }
  label.f { display:block; font-size:15px; font-weight:600; color:var(--ink); margin-bottom:6px; margin-top:12px; }
  .fld:first-child > label.f, .grid > .fld > label.f { margin-top:0; }
  .grid > .fld { margin-bottom:10px; }
  .toolbar { display:grid; grid-template-columns:1fr auto auto auto; gap:10px; margin-bottom:12px; }
  .filters { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-bottom:14px; } .filters label.f { margin-top:0; }
  @media (max-width:1100px){ .filters{grid-template-columns:repeat(3,1fr);} .toolbar{grid-template-columns:1fr 1fr;} }
  table { width:100%; border-collapse:collapse; font-size:14px; }
  th { text-align:left; font-size:13px; color:var(--ink-subtle); padding:12px 12px; border-bottom:1px solid var(--border); font-weight:600; white-space:nowrap; }
  td { padding:10px 12px; border-bottom:1px solid var(--border); vertical-align:middle; } tr:last-child td { border-bottom:0; }
  tr.row:hover td { background:var(--surface-subtle); cursor:pointer; }
  .tbl { overflow:auto; border-radius:var(--radius); } .card.flush { padding:0; }
  .empty { padding:40px; text-align:center; color:var(--ink-subtle); }
  .seg { display:inline-flex; background:transparent; border-radius:12px; padding:0; gap:4px; flex-wrap:wrap; }
  .seg button { border:0; background:transparent; padding:10px 18px; border-radius:12px; font-weight:500; color:var(--ink-muted); font-size:15px; white-space:nowrap; }
  .seg button.on { background:var(--surface); border:1px solid var(--border); font-weight:700; color:var(--ink); }
  .outcomes { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .outcomes button { border:1px solid var(--border); background:var(--surface); border-radius:12px; padding:12px 10px; text-align:left; color:var(--ink); font-weight:500; }
  .outcomes button.on { border-color:var(--brand); background:var(--brand-tint); color:var(--brand); }
  .timeline li { display:grid; grid-template-columns:34px 1fr auto; gap:10px; padding:10px 0; border-bottom:1px solid var(--border); align-items:start; } .timeline li:last-child { border-bottom:0; }
  .timeline .dot { width:34px; height:34px; border-radius:50%; background:var(--surface-subtle); display:grid; place-items:center; } .timeline time { font-size:12px; color:var(--ink-subtle); white-space:nowrap; }
  ul { list-style:none; margin:0; padding:0; }
  .alert { border-radius:12px; padding:12px 14px; font-size:14px; } .alert.red { background:rgba(255,59,48,.12); color:var(--danger); } .alert.blue { background:var(--brand-tint); color:var(--brand); } .alert.gray { background:var(--surface-subtle); color:var(--ink-muted); } .alert.green { background:rgba(52,199,89,.15); color:var(--green-text); }
  .row-line { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 0; border-bottom:1px solid var(--border); } .row-line:last-child { border-bottom:0; }
  .mono { font-variant-numeric:tabular-nums; } .muted { color:var(--ink-subtle); } .small { font-size:13px; } .b { font-weight:600; }
  .progress { height:10px; background:var(--surface-subtle); border-radius:999px; overflow:hidden; } .progress i { display:block; height:100%; background:var(--brand); border-radius:999px; }
  dialog { border:0; border-radius:18px; padding:0; background:var(--surface); color:var(--ink); width:min(560px,94vw); max-height:90vh; box-shadow:0 20px 60px rgba(0,0,0,.3); }
  dialog.wide { width:min(900px,96vw); } dialog::backdrop { background:rgba(0,0,0,.4); }
  dialog .body { padding:22px; overflow:auto; max-height:70vh; } dialog h3 { margin:0 0 6px; font-size:18px; }
  dialog .foot { display:flex; justify-content:flex-end; gap:8px; padding:14px 22px 20px; border-top:1px solid var(--border); }
  .toast { position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:var(--ink); color:var(--bg); padding:10px 18px; border-radius:999px; font-weight:600; font-size:14px; opacity:0; transition:opacity .2s; pointer-events:none; z-index:50; } .toast.show { opacity:1; }
  .split { display:grid; grid-template-columns:1.3fr 1fr; gap:16px; } @media (max-width:1000px){ .split{grid-template-columns:1fr;} }
  .rank { width:32px; height:32px; border-radius:50%; background:var(--surface-subtle); display:grid; place-items:center; font-weight:700; flex-shrink:0; } .rank.r1{background:#FFD60A;color:#000;} .rank.r2{background:#C7C7CC;color:#000;} .rank.r3{background:#D2A06D;color:#000;}
  pre.tpl { white-space:pre-wrap; background:var(--surface-subtle); border-radius:12px; padding:12px; font-family:inherit; margin:0; font-size:14px; }
  .bubble { background:var(--brand); color:#fff; border-radius:18px 18px 4px 18px; padding:10px 14px; max-width:420px; margin-left:auto; white-space:pre-wrap; font-size:14px; }
  .login { min-height:100vh; display:grid; place-items:center; padding:20px; } .login .card { width:min(440px,100%); }
  .user-btn { display:flex; align-items:center; gap:12px; width:100%; border:1px solid var(--border); background:var(--surface); border-radius:12px; padding:10px 12px; text-align:left; color:var(--ink); margin-top:8px; } .user-btn:hover { background:var(--surface-subtle); }
  /* ---- CRM pipeline ---- */
  .crm-toolbar { grid-template-columns:200px 1fr 200px auto; }
  .crm-board { display:flex; gap:12px; overflow-x:auto; padding:4px 2px 16px; scroll-snap-type:x proximity; -webkit-overflow-scrolling:touch; }
  .crm-col { flex:0 0 300px; scroll-snap-align:start; background:var(--surface-subtle); border-radius:14px; display:flex; flex-direction:column; max-height:calc(100vh - 230px); min-height:320px; }
  .crm-col.over { outline:2px dashed var(--brand); outline-offset:-2px; }
  .crm-head { border-top:4px solid var(--brand); border-radius:14px 14px 0 0; padding:10px 12px 8px; background:var(--surface); position:sticky; top:0; z-index:1; }
  .crm-title { display:flex; align-items:center; gap:6px; } .crm-title .dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
  .crm-stats { display:flex; gap:10px; font-size:12px; color:var(--ink-subtle); margin:6px 0 8px; flex-wrap:wrap; } .crm-stats .b { color:var(--ink); font-weight:600; }
  .crm-cards { padding:10px; overflow-y:auto; display:flex; flex-direction:column; gap:10px; flex:1; }
  .crm-empty { border:2px dashed var(--border); border-radius:12px; padding:20px; text-align:center; color:var(--ink-subtle); font-size:13px; }
  .deal { background:var(--surface); border-radius:12px; padding:10px 12px; border-left:4px solid var(--success); cursor:grab; box-shadow:0 1px 2px rgba(0,0,0,.06); }
  .deal.dragging { opacity:.5; } .deal.tone-red { border-left-color:var(--danger); } .deal.tone-yellow { border-left-color:var(--warning); } .deal.tone-green { border-left-color:var(--success); } .deal.tone-gray { border-left-color:var(--ink-subtle); opacity:.8; }
  .deal-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; } .deal-name { font-weight:600; font-size:15px; display:block; }
  .deal-money { margin:6px 0 2px; font-size:14px; } .deal-actions { display:flex; gap:6px; margin-top:8px; flex-wrap:wrap; } .deal-actions .btn { min-height:34px; padding:0 10px; } .deal-actions .lbl { display:none; }
  .crm-mobile-nav, .crm-mobile-one { display:none; }
  .swatches { display:flex; gap:6px; flex-wrap:wrap; } .swatch { width:28px; height:28px; border-radius:50%; border:3px solid transparent; cursor:pointer; } .swatch.on { border-color:var(--ink); }
  .badge.blue { background:var(--brand-tint); color:var(--brand); }
  @media (max-width:900px){
    .crm-board { display:none; } .crm-toolbar { grid-template-columns:1fr 1fr; }
    .crm-mobile-nav { display:grid; grid-template-columns:44px 1fr 44px; gap:8px; margin-bottom:10px; }
    .crm-mobile-one { display:block; } .crm-mobile-one .crm-col { max-height:none; flex:none; } .crm-mobile-one .crm-cards { overflow:visible; }
    .deal { cursor:default; } .deal-actions .btn { min-height:44px; flex:1 1 30%; } .deal-actions .lbl { display:inline; }
  }
  .bottomnav { display:none; } .checks label { display:flex; gap:8px; align-items:center; padding:6px 0; }
  .callbar { display:none; }
  .queue-bar, .queue-bar > * { min-width:0; }
  .cardgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:14px; }
  .msgcard textarea { min-height:110px; }
  @media (max-width:900px){ .layout{grid-template-columns:1fr;} .sidebar{display:none;} main{padding:16px 16px 90px;} .page-head h2{font-size:24px;} .split{grid-template-columns:1fr;}
    .bottomnav { display:flex; position:fixed; bottom:0; left:0; right:0; background:color-mix(in srgb,var(--surface) 88%,transparent); backdrop-filter:blur(20px); border-top:1px solid var(--border); padding:6px 4px calc(6px + env(safe-area-inset-bottom)); z-index:10; }
    /* One-thumb call bar above the tab bar; the top queue bar drops its buttons. */
    .callbar { display:block; position:fixed; left:0; right:0; bottom:calc(58px + env(safe-area-inset-bottom)); z-index:11; background:color-mix(in srgb,var(--surface) 92%,transparent); backdrop-filter:blur(20px); border-top:1px solid var(--border); padding:8px 12px; }
    .callbar .row1 { display:grid; grid-template-columns:1fr auto auto; gap:8px; }
    .callbar .row2 { display:flex; align-items:center; justify-content:space-between; margin-top:4px; }
    .qb-actions { display:none; }
    .topbar { padding:0 12px; gap:6px; }
    .topbar .pill.team { display:none; }
    .topbar .pill.who { max-width:34vw; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bottomnav a { flex:1; text-align:center; font-size:11px; color:var(--ink-subtle); padding:4px 0; } .bottomnav a.active { color:var(--brand); } .bottomnav a span { display:block; font-size:20px; } .outcomes{grid-template-columns:1fr 1fr;} .cardgrid{grid-template-columns:1fr;} }

  /* admin */
  .switch { appearance:none; width:40px; height:22px; border-radius:999px; background:var(--border); position:relative; cursor:pointer; flex-shrink:0; transition:background .15s; }
  .switch::after { content:""; position:absolute; top:2px; left:2px; width:18px; height:18px; border-radius:50%; background:#fff; box-shadow:0 1px 2px rgba(0,0,0,.25); transition:left .15s; }
  .switch:checked { background:var(--success); } .switch:checked::after { left:20px; } .switch:disabled { opacity:.5; cursor:not-allowed; }
  .perm-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:6px 18px; padding:6px 0 4px; }
  .perm { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); font-size:14px; min-height:44px; }
  .adm-details { border:1px solid var(--border); border-radius:10px; padding:0 12px; margin-top:8px; background:var(--surface); }
  .adm-details > summary { cursor:pointer; padding:10px 0; font-weight:600; list-style:none; display:flex; align-items:center; gap:8px; min-height:44px; }
  .adm-details > summary::before { content:"›"; display:inline-block; transition:transform .15s; color:var(--ink-muted); } .adm-details[open] > summary::before { transform:rotate(90deg); }
  .role-list { list-style:none; margin:0; padding:6px; } .role-list li { padding:10px 12px; border-radius:10px; cursor:pointer; } .role-list li:hover { background:var(--surface-subtle); } .role-list li.on { background:var(--brand-tint); }
  .checks { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:4px 12px; padding:4px 0 10px; }
  .check { display:flex; align-items:center; gap:8px; font-size:14px; min-height:36px; }
  .swatch { display:inline-block; width:12px; height:12px; border-radius:50%; margin-right:4px; vertical-align:-1px; } .swatch.lg { width:28px; height:28px; margin:0; border:2px solid transparent; }
  .swatches { display:flex; gap:8px; flex-wrap:wrap; } .swatches label { cursor:pointer; } .swatches input { display:none; } .swatches input:checked + .swatch { border-color:var(--ink); box-shadow:0 0 0 2px var(--surface); }
  .team-logo { width:44px; height:44px; border-radius:12px; color:#fff; display:grid; place-items:center; font-weight:700; overflow:hidden; flex-shrink:0; } .team-logo img { width:100%; height:100%; object-fit:cover; }
  .avatars { display:flex; gap:4px; flex-wrap:wrap; }
  .admin-tbl td:last-child { white-space:nowrap; } .admin-tbl td:last-child .actions { flex-wrap:nowrap; }
  @media (max-width:900px){ #rolesGrid { grid-template-columns:1fr !important; } .perm-grid { grid-template-columns:1fr; }
    .admin-tbl table, .admin-tbl thead, .admin-tbl tbody, .admin-tbl tr, .admin-tbl td { display:block; } .admin-tbl thead { display:none; } .admin-tbl tr { border:1px solid var(--border); border-radius:12px; margin:10px; padding:8px 12px; background:var(--surface); } .admin-tbl td { border:0; padding:4px 0; } .admin-tbl td .actions { justify-content:flex-start !important; flex-wrap:wrap; } }
</style>
</head>
<body>
<div id="app"></div>
<dialog id="dlg"></dialog>
<div class="toast" id="toast"></div>
<input type="file" id="fileIn" accept=".csv,.xlsx,.xls,.txt" hidden>
<input type="file" id="restoreIn" accept=".json" hidden>

<script>
/* =====================================================================
   Prospecting Call Tracker — working single-file demo.
   Everything runs in this page's memory. Use Settings → Backup to save
   your test data to a file and restore it later.
   ===================================================================== */
const $ = (s, r=document) => r.querySelector(s);
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const pad = (n) => String(n).padStart(2,"0");
const todayD = () => { const x=new Date(); x.setHours(0,0,0,0); return x; };
const isoDate = (x) => `${x.getFullYear()}-${pad(x.getMonth()+1)}-${pad(x.getDate())}`;
const TODAY = isoDate(todayD());
const daysAgo = (n, h=10) => { const x=todayD(); x.setDate(x.getDate()-n); x.setHours(h, (n*7)%60); return x.toISOString(); };
const addDays = (s, n) => { const x=new Date(s+"T00:00"); x.setDate(x.getDate()+n); return isoDate(x); };
const fmtD = (s) => s ? new Date(s.length>10 ? s : s+"T00:00").toLocaleDateString(undefined,{month:"short",day:"numeric"}) : "—";
const fmtDT = (s) => s ? new Date(s).toLocaleString(undefined,{month:"short",day:"numeric",hour:"numeric",minute:"2-digit"}) : "—";
const digits = (s) => String(s ?? "").replace(/\D/g,"");
const normPhone = (s) => { let d = digits(s); if (d.length===11 && d[0]==="1") d = d.slice(1); return d.length===10 ? "+1"+d : null; };
const prettyRaw = (n) => n ? n.replace(/^\+1(\d{3})(\d{3})(\d{4})$/,"($1) $2-$3") : "—";
const pretty = (n) => (!n || !me || can("viewPhones")) ? prettyRaw(n) : n.replace(/^\+1(\d{3})\d{3}(\d{4})$/,"($1) •••-$2");
const isApple = () => /iPhone|iPad|Macintosh/.test(navigator.userAgent);
const smsHref = (n, body) => `sms:${n}` + (body ? (isApple() ? "&" : "?") + "body=" + encodeURIComponent(body) : "");
function toast(m){ const t=$("#toast"); t.textContent=m; t.classList.add("show"); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove("show"),2000); }
function download(name, text, mime="text/csv"){ const a=document.createElement("a"); a.href=URL.createObjectURL(new Blob([text],{type:mime})); a.download=name; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),2000); }

// ---------------------------------------------------------------- permissions
/**
 * Permissions. Every role — built-in or custom — is a named set of these
 * switches. The Owner / Super Administrator role always has everything.
 * Existing features keep their old capability names; the LEGACY map turns
 * an old name into the permission that now decides it.
 */
const PERMISSIONS = [
  // Leads
  ["viewOwnLeads",     "View own leads",                       "Leads"],
  ["viewTeamLeads",    "View team leads (same team)",          "Leads"],
